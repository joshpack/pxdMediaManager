<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:pxdMediaManager.Views"
        x:Class="pxdMediaManager.Views.MainWindow"
        Title="pxd Media Manager"
        Width="780" Height="800" MinWidth="660" MinHeight="580"
        WindowStartupLocation="CenterScreen">

  <Panel>
    <!-- Ambient neon glow in opposite corners -->
    <Border IsHitTestVisible="False">
      <Border.Background>
        <RadialGradientBrush Center="0%,0%" GradientOrigin="0%,0%" RadiusX="75%" RadiusY="75%">
          <GradientStop Color="#2400C8FF" Offset="0" />
          <GradientStop Color="#0000C8FF" Offset="1" />
        </RadialGradientBrush>
      </Border.Background>
    </Border>
    <Border IsHitTestVisible="False">
      <Border.Background>
        <RadialGradientBrush Center="100%,100%" GradientOrigin="100%,100%" RadiusX="75%" RadiusY="75%">
          <GradientStop Color="#2019F58C" Offset="0" />
          <GradientStop Color="#0019F58C" Offset="1" />
        </RadialGradientBrush>
      </Border.Background>
    </Border>

  <Grid RowDefinitions="Auto,*" Margin="28,24,28,24">

    <!-- Header -->
    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,18">
      <Border Width="46" Height="46" CornerRadius="12" BoxShadow="0 0 22 0 #6600C8FF, 0 0 38 4 #3319F58C">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#00C8FF" Offset="0" />
            <GradientStop Color="#19F58C" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
        <Viewbox Margin="11">
          <Path x:Name="Spade" Fill="#04140C" Width="100" Height="100" Stretch="Uniform" />
        </Viewbox>
      </Border>
      <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="2">
        <TextBlock Text="pxd Media Manager" FontSize="20" FontWeight="Bold" Classes="neon" />
        <TextBlock Text="Torrents, library and media, all in one place" Classes="muted" />
      </StackPanel>
      <Border Grid.Column="2" x:Name="StatusPill" CornerRadius="999" Padding="12,6" VerticalAlignment="Center"
              Background="#0C2A1D" BorderBrush="#146B44" BorderThickness="1" BoxShadow="0 0 16 0 #4419F58C">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Ellipse x:Name="StatusDot" Classes="pulse" Width="8" Height="8" Fill="{StaticResource GoodBrush}"
                   Effect="drop-shadow(0 0 7 #19F58C)" VerticalAlignment="Center" />
          <TextBlock x:Name="StatusText" Text="Watching" FontWeight="SemiBold" FontSize="12" />
        </StackPanel>
      </Border>
    </Grid>

    <TabControl x:Name="MainTabs" Grid.Row="1" Padding="0">

      <!-- Dashboard -->
      <TabItem Header="Dashboard">
        <ScrollViewer>
          <StackPanel Spacing="14" Margin="0,16,14,0">
            <Grid ColumnDefinitions="*,12,*,12,*,12,*">
              <Border Classes="card">
                <StackPanel Spacing="4">
                  <TextBlock Text="TODAY" Classes="label" />
                  <TextBlock x:Name="TodayCount" Classes="big" Text="0" />
                  <TextBlock x:Name="TodaySize" Classes="muted" Text="—" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="card">
                <StackPanel Spacing="4">
                  <TextBlock Text="THIS WEEK" Classes="label" />
                  <TextBlock x:Name="WeekCount" Classes="big" Text="0" />
                  <TextBlock x:Name="WeekSize" Classes="muted" Text="—" />
                </StackPanel>
              </Border>
              <Border Grid.Column="4" Classes="card">
                <StackPanel Spacing="4">
                  <TextBlock Text="THIS MONTH" Classes="label" />
                  <TextBlock x:Name="MonthCount" Classes="big" Text="0" />
                  <TextBlock x:Name="MonthSize" Classes="muted" Text="—" />
                </StackPanel>
              </Border>
              <Border Grid.Column="6" Classes="card">
                <StackPanel Spacing="4">
                  <TextBlock Text="ALL TIME" Classes="label" />
                  <TextBlock x:Name="AllCount" Classes="big blue" Text="0" />
                  <TextBlock x:Name="AllSize" Classes="muted" Text="—" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Classes="card">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="LAST 14 DAYS" Classes="label" VerticalAlignment="Center" />
                  <TextBlock x:Name="ChartSummary" Grid.Column="1" Classes="muted" />
                </Grid>
                <Grid x:Name="ChartGrid" Height="170" />
              </StackPanel>
            </Border>

            <TextBlock x:Name="DashSyncText" Classes="muted" FontSize="11" IsVisible="False" />

            <Border x:Name="TrackingCard" Classes="card" IsVisible="False">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="WAITING FOR DOWNLOADS" Classes="label" VerticalAlignment="Center" />
                  <Button x:Name="ClearTrackingButton" Grid.Column="1" Classes="ghost" Content="Stop tracking"
                          MinHeight="30" Padding="10,4" />
                </Grid>
                <ItemsControl x:Name="TrackingList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="views:TrackingItem">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,5">
                        <Ellipse Width="8" Height="8" Fill="#00C8FF" Effect="drop-shadow(0 0 6 #00C8FF)" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Text}" />
                        <TextBlock Grid.Column="2" Text="{Binding Size}" Classes="muted" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                       Text="Privacy: only the date and total size of each transfer is recorded. Torrent names are never stored in the history or activity log." />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Activity -->
      <!-- Library -->
      <TabItem Header="Library">
        <views:LibraryView x:Name="LibraryPane" />
      </TabItem>

      <!-- Discover: suggestions worked out from the library and watch history -->
      <TabItem Header="Discover">
        <views:DiscoverView x:Name="DiscoverPane" />
      </TabItem>

      <TabItem Header="Activity">
        <Border Classes="card" Padding="0" Margin="0,16,0,0">
          <Grid RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="*,Auto" Margin="18,14,10,10">
              <TextBlock Text="RECENT EVENTS" Classes="label" VerticalAlignment="Center" />
              <Button x:Name="ClearActivityButton" Grid.Column="1" Classes="ghost" Content="Clear" MinHeight="30" Padding="10,4" />
            </Grid>
            <Panel Grid.Row="1">
              <TextBlock x:Name="EmptyText" Text="Nothing yet — new torrents will show up here."
                         Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <ScrollViewer>
                <ItemsControl x:Name="ActivityList" Margin="10,0,10,10">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="views:ActivityItem">
                      <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,9" ColumnSpacing="12">
                        <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Top" Margin="0,6,0,0" />
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Detail}" Classes="muted" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding Time}" Classes="muted" FontSize="11"
                                   VerticalAlignment="Top" Margin="0,2,0,0" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Panel>
          </Grid>
        </Border>
      </TabItem>

      <!-- Settings -->
      <TabItem Header="Settings">
        <ScrollViewer>
          <Border Classes="card" Margin="0,16,14,0">
            <StackPanel Spacing="16">
              <StackPanel Spacing="6">
                <TextBlock Text="SETTINGS FILE" Classes="label" />
                <Grid ColumnDefinitions="*,8,Auto,4,Auto">
                  <TextBox x:Name="SettingsFolderBox" PlaceholderText="Shared folder for one settings file used by all your machines (optional)" />
                  <Button x:Name="BrowseSettingsFolderButton" Grid.Column="2" Content="Browse" />
                  <Button x:Name="ClearSettingsFolderButton" Grid.Column="4" Classes="ghost" Content="Off" MinWidth="67" ToolTip.Tip="Keep settings on this machine only" />
                </Grid>
                <TextBlock x:Name="SettingsFileText" Classes="muted" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Spacing="6">
                <TextBlock Text="WATCH FOLDER" Classes="label" />
                <Grid ColumnDefinitions="*,8,Auto,4,Auto">
                  <TextBox x:Name="WatchBox" PlaceholderText="Folder to monitor for new .torrent files" />
                  <Button x:Name="BrowseWatchButton" Grid.Column="2" Content="Browse" />
                  <Button x:Name="OpenWatchButton" Grid.Column="4" Classes="ghost" Content="Open" />
                </Grid>
              </StackPanel>
              <StackPanel Spacing="6">
                <TextBlock Text="TARGET FOLDER" Classes="label" />
                <Grid ColumnDefinitions="*,8,Auto,4,Auto">
                  <TextBox x:Name="TargetBox" PlaceholderText="Where torrents are sent (e.g. your NAS share)" />
                  <Button x:Name="BrowseTargetButton" Grid.Column="2" Content="Browse" />
                  <Button x:Name="OpenTargetButton" Grid.Column="4" Classes="ghost" Content="Open" />
                </Grid>
              </StackPanel>

              <Border Height="1" Background="{StaticResource BorderBrush2}" />

              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="CATEGORIES" Classes="label" VerticalAlignment="Center" />
                  <Button x:Name="AddCategoryButton" Grid.Column="1" Classes="ghost" Content="+ Add category"
                          MinHeight="30" Padding="10,4" />
                </Grid>
                <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                           Text="Pick one when a torrent arrives and the finished download is moved there automatically. Use a local folder or a network share." />
                <ItemsControl x:Name="CategoryList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="views:CategoryItem">
                      <Grid ColumnDefinitions="150,8,*,8,Auto,10,Auto,4,Auto" Margin="0,3">
                        <TextBox Text="{Binding Name, Mode=TwoWay}" PlaceholderText="Name (e.g. Movies)" />
                        <TextBox Grid.Column="2" Text="{Binding Folder, Mode=TwoWay}" PlaceholderText="Folder or network share" />
                        <Button Grid.Column="4" Content="Browse" Click="OnBrowseCategory" />
                        <CheckBox Grid.Column="6" Content="Library" IsChecked="{Binding InLibrary, Mode=TwoWay}" VerticalAlignment="Center"
                                  ToolTip.Tip="Show this category in the Library tab" />
                        <Button Grid.Column="8" Classes="ghost" Content="✕" Click="OnRemoveCategory" ToolTip.Tip="Remove" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <Border Height="1" Background="{StaticResource BorderBrush2}" />

              <StackPanel Spacing="8">
                <TextBlock Text="MOVIE &amp; TV POSTERS (TMDB)" Classes="label" />
                <Grid ColumnDefinitions="*,8,Auto">
                  <TextBox x:Name="TmdbBox" PasswordChar="•" PlaceholderText="TMDB API key or Read Access Token (optional)" />
                  <Button x:Name="TmdbTestButton" Grid.Column="2" Content="Test" MinWidth="67" />
                </Grid>
                <TextBlock x:Name="TmdbText" Classes="muted" FontSize="11" TextWrapping="Wrap"
                           Text="Free at themoviedb.org → Settings → API. Either the API key or the Read Access Token works. Titles from your Movies and TV categories are sent to TMDB to find posters; posters are cached on this machine, and the key stays on this machine only." />
                <TextBlock Text="EXTRA RATINGS (OMDb: IMDb, ROTTEN TOMATOES, METACRITIC)" Classes="label" Margin="0,8,0,0" />
                <Grid ColumnDefinitions="*,8,Auto">
                  <TextBox x:Name="OmdbBox" PasswordChar="•" PlaceholderText="OMDb API key (optional)" />
                  <Button x:Name="OmdbTestButton" Grid.Column="2" Content="Test" MinWidth="67" />
                </Grid>
                <TextBlock x:Name="OmdbText" Classes="muted" FontSize="11" TextWrapping="Wrap"
                           Text="Free at omdbapi.com → API Key (1,000 lookups a day). Needs the TMDB key above to find each title's IMDb ID. Ratings are fetched once per title and cached on this machine; the key stays on this machine only." />
                <TextBlock Text="MORE RATINGS (MDBList: TRAKT, LETTERBOXD, RT AUDIENCE, METACRITIC USERS, ROGER EBERT, MYANIMELIST…)" Classes="label"
                           TextWrapping="Wrap" Margin="0,8,0,0" />
                <Grid ColumnDefinitions="*,8,Auto">
                  <TextBox x:Name="MdbListBox" PasswordChar="•" PlaceholderText="MDBList API key (optional)" />
                  <Button x:Name="MdbListTestButton" Grid.Column="2" Content="Test" MinWidth="67" />
                </Grid>
                <TextBlock x:Name="MdbListText" Classes="muted" FontSize="11" TextWrapping="Wrap"
                           Text="Free at mdblist.com → sign in → Preferences → API key. Needs the TMDB key above. TV shows also get a TVmaze rating, which needs no key. Everything is fetched once per title and cached on this machine." />
                <TextBlock Text="SUBTITLE FINDER (OPENSUBTITLES)" Classes="label" Margin="0,8,0,0" />
                <Grid ColumnDefinitions="*,8,110,8,Auto">
                  <TextBox x:Name="OpenSubsBox" PasswordChar="•" PlaceholderText="OpenSubtitles API key (optional)" />
                  <TextBox x:Name="SubLangBox" Grid.Column="2" PlaceholderText="en" ToolTip.Tip="Languages to search, e.g. en or en,es" />
                  <Button x:Name="OpenSubsTestButton" Grid.Column="4" Content="Test" MinWidth="67" />
                </Grid>
                <TextBlock x:Name="OpenSubsText" Classes="muted" FontSize="11" TextWrapping="Wrap"
                           Text="Free at opensubtitles.com → profile → API consumers → New consumer. Lets the details window find subtitles and save them next to the video, where the player picks them up. Anonymous downloads are limited to a few a day." />
                <TextBlock Text="LIBRARY GAMES &amp; AUDIOBOOKS" Classes="label" Margin="0,8,0,0" />
                <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                           Text="Categories named like Games are looked up on Steam, categories named like Audiobooks in Audible's catalogue, and Anime categories also get AniList scores. None of these need a key. Folders in other categories are recognised as games or audiobooks from their files." />
                <CheckBox x:Name="ArrivalAlertsBox" Content="Pop up a notice (with poster and rating) when a finished download lands in a library category" Margin="0,8,0,0" />
                <Border Height="1" Margin="0,8" Background="{StaticResource BorderBrush2}" />
                <TextBlock Text="START AT LOGIN" Classes="label" />
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <Ellipse x:Name="AutostartDot" Width="8" Height="8" Fill="#8A92A6" VerticalAlignment="Center" />
                  <TextBlock x:Name="AutostartText" Grid.Column="1" Text="Checking…" Classes="muted"
                             VerticalAlignment="Center" TextWrapping="Wrap" />
                  <Button x:Name="AutostartButton" Grid.Column="2" Content="Checking…" IsEnabled="False" MinWidth="170" />
                </Grid>
                <Border Height="1" Margin="0,8" Background="{StaticResource BorderBrush2}" />
                <TextBlock Text="TRAY ICON" Classes="label" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <CheckBox x:Name="TrayIconBox" Content="Show the tray icon" VerticalAlignment="Center"
                            ToolTip.Tip="pxd Toolkit has the same switch; either one changes both" />
                  <Button x:Name="QuitButton" Grid.Column="1" Classes="ghost" Content="Quit pxd Media Manager" />
                </Grid>
                <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                           Text="Works with pxd Toolkit, which can turn the icon on and off too. With the icon hidden the app keeps running: start it again, or open it from pxd Toolkit, to bring this window back. Closing this window leaves the app running; Quit stops it." />
              </StackPanel>

              <Border Height="1" Background="{StaticResource BorderBrush2}" />

              <StackPanel Spacing="6">
                <TextBlock Text="SYNC STATS ACROSS MACHINES" Classes="label" />
                <CheckBox x:Name="ShareStatsBox" Content="Combine download stats with other machines through the shared settings folder above" />
                <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                           Text="Each machine writes only its own stats file into that folder (times and sizes, no torrent names), so they can never overwrite each other; the dashboard adds them all up." />
                <TextBlock x:Name="SyncText" Classes="muted" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>

              <Border Height="1" Background="{StaticResource BorderBrush2}" />

              <Grid ColumnDefinitions="*,Auto,8,Auto,8,Auto,8,Auto">
                <TextBlock x:Name="IgnoredText" Classes="muted" VerticalAlignment="Center" />
                <Button x:Name="ClearIgnoredButton" Grid.Column="1" Classes="ghost" Content="Clear ignored" />
                <Button x:Name="ResetStatsButton" Grid.Column="3" Classes="ghost" Content="Reset statistics" />
                <Button x:Name="SaveOnlyButton" Grid.Column="5" Content="Save" MinWidth="90"
                        ToolTip.Tip="Save the settings and keep this window open" />
                <Button x:Name="SaveButton" Grid.Column="7" Classes="primary" Content="Save &amp; Close" MinWidth="130" />
              </Grid>
            </StackPanel>
          </Border>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
  </Panel>
</Window>
