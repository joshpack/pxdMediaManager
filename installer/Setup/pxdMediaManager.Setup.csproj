<Project Sdk="Microsoft.NET.Sdk">

  <!-- pxd-media-manager-setup.exe: one file that installs pxd Media Manager for the current user (no admin, no .NET
       needed). The app itself is a folder (its video player's native libraries have to be real files), so it travels
       inside this program as payload.zip, made by ..\build-setup.ps1. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>pxdMediaManager.Setup</RootNamespace>
    <AssemblyName>pxd-media-manager-setup</AssemblyName>
    <Product>pxd Media Manager</Product>
    <Company>pxd</Company>
    <Version>1.2.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon Condition="Exists('..\spade.ico')">..\spade.ico</ApplicationIcon>
    <PayloadZip Condition="'$(PayloadZip)' == ''">payload.zip</PayloadZip>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <!-- off-screen drawing for the screenshot option (checking the design without opening a window) -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="payload.zip" Condition="Exists('$(PayloadZip)')" />
  </ItemGroup>

</Project>
